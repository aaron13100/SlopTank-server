From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Keep subtitle decode; omit unused 8/30 metadata

SlopTank modification notice: added or changed by SlopTank on 2026-11-05.
Based on libzvbi commit 41477c97c8edf7a01f1594b2a95b94f0117eed21.
Teletext subtitle decoding and the initial page link remain in place.

---
diff --git a/src/Makefile.am b/src/Makefile.am
index 738bd38..c8ea9c7 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -98,9 +98,9 @@ libzvbi_la_SOURCES = \
 	misc.c misc.h \
 	network.h \
 	packet.c teletext.c teletext_decoder.h vt.h \
-	packet-830.c packet-830.h \
+	packet-830.h \
 	page_table.c page_table.h \
-	pdc.c pdc.h \
+	pdc.h \
 	pfc_demux.c pfc_demux.h \
 	proxy-client.c proxy-client.h \
 	raw_decoder.c raw_decoder.h \
diff --git a/src/packet.c b/src/packet.c
index b779544..c388083 100644
--- a/src/packet.c
+++ b/src/packet.c
@@ -44,7 +44,6 @@
 #include "vps.h"
 #include "vbi.h"
 #include "cache-priv.h"
-#include "packet-830.h"
 
 #ifndef FPC
 #  define FPC 0
@@ -2134,45 +2133,6 @@ parse_8_30(vbi_decoder *vbi, uint8_t *buffer, int packet)
 			return FALSE;
 	}
 
-	if (designation < 2) {
-		/* 8/30 format 1 */
-
-		if (vbi->event_mask & VBI_EVENT_LOCAL_TIME) {
-			vbi_local_time lt;
-			vbi_event e;
-
-			CLEAR (e);
-
-			if (!vbi_decode_teletext_8301_local_time
-			    (&lt.time, &lt.seconds_east, buffer))
-				return FALSE;
-
-			lt.seconds_east_valid = TRUE;
-			lt.dst_state = VBI_DST_INCLUDED;
-
-			e.type = VBI_EVENT_LOCAL_TIME;
-			e.ev.local_time	= &lt;
-
-			vbi_send_event (vbi, &e);
-		}
-	} else {
-		/* 8/30 format 2 */
-
-		if (vbi->event_mask & VBI_EVENT_PROG_ID) {
-			vbi_program_id pid;
-			vbi_event e;
-			
-			if (!vbi_decode_teletext_8302_pdc (&pid, buffer))
-				return FALSE;
-
-			CLEAR (e);
-
-			e.type = VBI_EVENT_PROG_ID;
-			e.ev.prog_id = &pid;
-
-			vbi_send_event (vbi, &e);
-		}
-	}
 
 	return TRUE;
 }
