{
  "schema": "org.sloptank.build-recipe/v1",
  "artifact_kind": "server",
  "working_directory": ".",
  "dependency_locks": [
    "Directory.Packages.props",
    "global.json"
  ],
  "toolchain_constraints": {
    "dotnet_sdk": "10.x",
    "runtime": "osx-x64",
    "self_contained": true
  },
  "commands": [
    [
      "dotnet",
      "restore",
      "Jellyfin.sln"
    ],
    [
      "dotnet",
      "publish",
      "Jellyfin.Server/Jellyfin.Server.csproj",
      "--configuration",
      "Release",
      "--runtime",
      "osx-x64",
      "--self-contained",
      "true"
    ]
  ],
  "output": "signed delivery directory containing SlopTank Server.app",
  "license_policy": "inherited-server=current-grant-interpreted-for-GPL-3.0-candidate;owner-increments=GPL-2.0-or-later;candidate-binary-election=GPL-3.0-only;external-binary-distribution=NO-GO"
}
